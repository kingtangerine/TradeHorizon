# Copy to .env and fill in real values on the server. Never commit .env.
# Every setting is optional; the defaults are shown or described.

# Where to listen (default 0.0.0.0:8787)
PORT=8787
HOST=0.0.0.0

# Accounts, user data, push keys and the market cache (default server/data). Back this folder up.
TH_DATA_DIR=server/data

# 1 when running behind nginx/Cloudflare, so login limits use the real visitor IP
TH_TRUST_PROXY=0

# Other origins whose pages may call the API, comma-separated. Default: the Android app
# (https://localhost,capacitor://localhost). Set to an empty value to allow none.
TH_ALLOWED_ORIGINS=https://localhost,capacitor://localhost

# Telegram bot token from @BotFather; leave empty to turn Telegram alerts off
TH_TELEGRAM_TOKEN=

# Comma-separated emails of the accounts that may open the admin page
TH_ADMIN_EMAILS=admin@example.com

# How many daily database backups to keep (default 14)
TH_BACKUP_KEEP=14

# The site's public address, for the keep-alive ping (optional)
TH_PUBLIC_URL=https://example.com

# Contact URL or mailto: sent to browser push services (optional)
TH_VAPID_SUBJECT=mailto:admin@example.com
