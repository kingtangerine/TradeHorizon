# Store text as LF in the repository and check it out as LF on every platform.
* text=auto eol=lf

# Binary files: never touched by line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff2 binary

# Windows batch files need CRLF to run reliably (the Gradle wrapper for the Android app).
*.bat text eol=crlf
