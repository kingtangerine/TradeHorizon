{
  "name": "trade-horizon",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.28.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev-all.ts",
    "dev:client": "vite",
    "server": "node server/index.ts",
    "start": "node build/server/index.js",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && tsc -b && vitest run",
    "version:bump": "node scripts/bump-version.ts",
    "user:list": "node scripts/user-admin.ts list",
    "user:password": "node scripts/user-admin.ts password"
  },
  "dependencies": {
    "klinecharts": "10.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.1.9",
    "vitest": "^4.0.0"
  }
}
